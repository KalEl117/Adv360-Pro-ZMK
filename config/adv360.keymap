#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        plus: plus {
            compatible = "zmk,behavior-mod-morph";
            label = "PLUS";
            bindings = <&kp RIGHT_BRACKET>, <&kp N1>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };
    };

    macros {
        delword: delword {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(BACKSPACE)>;
            label = "DELWORD";
        };

        keypass: keypass {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LA(A))>;
            label = "KEYPASS";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp LS(NUMBER_4)             &kp N1          &kp N2          &kp N3           &kp N4            &kp N5  &tog 1                                                              &mo 3        &kp N6  &kp N7             &kp N8       &kp N9          &kp N0              &kp LS(NUMBER_1)
&kp TAB                      &kp Q           &kp W           &kp E            &kp R             &kp T   &keypass                                                            &delword     &kp Y   &kp U              &kp I        &kp O           &kp P               &kp LEFT_BRACKET
&hm LCTRL ESC                &hm LEFT_GUI A  &hm LEFT_ALT S  &hm LCTRL D      &hm LEFT_SHIFT F  &kp G   &none            &kp LCTRL    &kp LALT      &kp LGUI   &kp RCTRL    &none        &kp H   &hm RIGHT_SHIFT J  &hm RCTRL K  &hm LEFT_ALT L  &hm RIGHT_GUI SEMI  &kp SQT
&kp LSHFT                    &kp Z           &kp X           &kp C            &kp V             &kp B                                 &kp HOME      &kp PG_UP                            &kp N   &kp M              &kp COMMA    &kp DOT         &kp MINUS           &kp RSHFT
&mt LA(LC(LEFT_SHIFT)) CAPS  &caps_word      &kp CAPS        &kp PRINTSCREEN  &kp SPACE                 &lt 1 BACKSPACE  &lt 2 ENTER  &kp END       &kp PG_DN  &lt 2 ENTER  &lt 1 SPACE          &kp LEFT_ARROW     &kp DOWN     &kp UP_ARROW    &kp RIGHT           &mt RA(RC(RIGHT_SHIFT)) CAPS
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1       &kp N2                &kp N3        &kp N4      &kp N5         &trans                                                   &mo 3      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp PAGE_UP  &kp BACKSPACE         &kp UP_ARROW  &kp DELETE  &kp PAGE_DOWN  &none                                                    &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp HOME     &kp LEFT              &kp DOWN      &kp RIGHT   &kp END        &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z        &kp C_AL_MY_COMPUTER  &kp TAB       &kp ENTER   &kp K_CALC                          &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 2      &kp GRAVE    &kp CAPS              &kp LEFT      &kp RIGHT                  &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F11  &kp F1         &kp F2            &kp F3        &kp F4                 &kp F5                 &tog 1                                      &mo 3   &kp F6             &kp F7      &kp F8            &kp F9        &kp F10           &kp F12
&trans   &kp RA(E)      &kp LS(QUESTION)  &kp RA(N8)    &kp RA(N9)             &kp TILDE              &none                                       &none   &kp LS(NUMBER_1)   &kp NUBS    &kp LS(NUBS)      &kp LS(N0)    &kp LS(NUMBER_6)  &trans
&trans   &kp RA(MINUS)  &kp LS(N7)        &kp RA(N7)    &kp RA(N0)             &kp LS(RIGHT_BRACKET)  &none   &trans  &trans      &trans  &trans  &none   &kp LS(MINUS)      &kp LS(N8)  &kp LS(N9)        &kp SLASH     &kp LS(DOT)       &kp RA(Q)
&trans   &kp BSLH       &kp LS(NUMBER_4)  &kp RA(NUBS)  &kp RA(RIGHT_BRACKET)  &kp PLUS                               &trans      &trans                  &kp RIGHT_BRACKET  &kp LS(N5)  &kp LS(NUMBER_2)  &kp LS(NUHS)  &kp LS(COMMA)     &trans
&trans   &trans         &trans            &trans        &trans                                        &trans  &trans  &trans      &trans  &trans  &trans                     &trans      &trans            &trans        &trans            &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};
